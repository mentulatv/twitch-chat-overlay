# Twitch Chat Overlay - account settings. Lines starting with # are ignored.

# The channel whose chat you want on screen (your Twitch username).
TWITCH_CHANNEL=

# Optional: only needed for FOLLOW and CHANNEL POINT alerts.
# Subs, gifts, raids and bits work without it.
# Create a free app at https://dev.twitch.tv/console/apps  ->  "Register Your Application"
#   Name: anything unique   OAuth Redirect URL: http://localhost
#   Category: Chat Bot      Client Type: Public
# then paste its Client ID here and run "Login to Twitch".
TWITCH_CLIENT_ID=

# Leave empty for a Public app. Only fill in if you used a Confidential app.
TWITCH_CLIENT_SECRET=
